	title = {Reverse {Engineering} of {Private} {Protocols}: {Methods}, {Tools}, {Challenges} and {Future} {Directions}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-7924-1},
	shorttitle = {Reverse {Engineering} of {Private} {Protocols}},
	url = {https://ieeexplore.ieee.org/document/11360359/},
	doi = {10.1109/DSC67331.2025.00020},
	abstract = {As the digital infrastructure grows, network protocols are essential for modern connectivity. However, many proprietary protocols used in IoT, ICS/SCADA, and mobile applications lack public documentation, creating “black boxes” that hinder security analysis and open hidden paths for cyberattacks. Private Protocol Reverse Engineering (PRE) addresses this by inferring protocol specifications from network traffic, binaries, or system behavior without prior knowledge.This survey reviews key PRE methods, including network traffic and program analysis, and highlights how machine learning enhances automation and accuracy. It introduces representative tools and real-world applications in IoT and ICS security and vulnerability discovery. The paper also outlines major challenges such as data dependency, protocol obfuscation, automation limits, and state machine complexity, while proposing future directions like multisource fusion, deep learning, and domain-specific optimization to strengthen PRE capabilities.},
	language = {en},
	urldate = {2026-08-10},
