	title = {{DY} {Fuzzing}: {Formal} {Dolev}-{Yao} {Models} {Meet} {Cryptographic} {Protocol} {Fuzz} {Testing}},
	copyright = {https://doi.org/10.15223/policy-009},
	isbn = {979-8-3503-3130-1},
	shorttitle = {{DY} {Fuzzing}},
	url = {https://ieeexplore.ieee.org/document/10646658/},
	doi = {10.1109/SP54263.2024.00096},
	abstract = {Critical and widely used cryptographic protocols have repeatedly been found to contain flaws in their design and their implementation. A prominent class of such vulnerabilities is logical attacks, e.g. attacks that exploit flawed protocol logic. Automated formal verification methods, based on the DolevYao (DY) attacker, formally define and excel at finding such flaws, but operate only on abstract specification models. Fully automated verification of existing protocol implementations is today still out of reach. This leaves open whether such implementations are secure. Unfortunately, this blind spot hides numerous attacks, such as recent logical attacks on widely used TLS implementations introduced by implementation bugs.},
	language = {en},
	urldate = {2026-08-10},
	booktitle = {2024 {IEEE} {Symposium} on {Security} and {Privacy} ({SP})},
	publisher = {IEEE},
